      "id": "3613de0e-a373-48b9-8557-26ded61fa3ac",
      "name": "Video Generation",
      "description": {
        "content": "Asynchronous AI video generation with the Hailuo models.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5821c442-83a4-46fe-a9cb-f13d34726643",
          "name": "Create a video generation task",
          "request": {
            "name": "Create a video generation task",
            "description": {
              "content": "Submits a video generation request and returns a task_id. Supports text-to-video (prompt only), image-to-video (first_frame_image), first-and-last-frame video (first_frame_image + last_frame_image), and subject-reference video (subject_reference for face-consistent characters). The task is processed asynchronously; poll GET /query/video_generation with the returned task_id.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "video_generation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"prompt\": \"<string>\",\n  \"first_frame_image\": \"<string>\",\n  \"last_frame_image\": \"<string>\",\n  \"subject_reference\": [\n    {\n      \"type\": \"<string>\",\n      \"image\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    {\n      \"type\": \"<string>\",\n      \"image\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  ],\n  \"duration\": \"<integer>\",\n  \"resolution\": \"<string>\",\n  \"prompt_optimizer\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "fb31aeea-6bd2-4ccb-9889-b16d1fac2016",
              "name": "Task accepted. Returns a task_id for polling.",
              "originalRequest": {
