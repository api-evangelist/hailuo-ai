        {
          "id": "52863324-7dc8-42ff-90c9-7817bb1ef049",
          "name": "Query a video generation task",
          "request": {
            "name": "Query a video generation task",
            "description": {
              "content": "Checks the status of a video generation task by task_id. Status progresses through Queueing, Preparing, Processing, then Success (which includes a file_id) or Fail. A polling interval of about 10 seconds is recommended to avoid unnecessary load.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "query",
                "video_generation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "task_id",
                  "value": "<string>",
                  "description": "(Required) The task_id returned by POST /video_generation."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
